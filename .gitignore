build/bin/
frontend/dist/*
!frontend/dist/.gitkeep
frontend/node_modules/
frontend/wailsjs/
devdeck

# local env files (analytics IDs etc.)
.env
.env.local
landing/node_modules/
landing/dist/

# marketing assets and drafts kept locally, not shipped with the source.
